# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp

# Env / secrets
.env
.env.*
!.env.example

# Common build/dependency dirs (harmless if unused by your stack)
node_modules/
dist/
build/
__pycache__/
*.pyc
.venv/

# Claude Code local state
.claude/settings.local.json

# NOT ignored, deliberately: .claude/.bootstrapped. It's tracked project
# state — git worktrees check out tracked files only, so ignoring it would
# make every parallel worktree look unconfigured and re-run bootstrap.
