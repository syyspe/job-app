DB_PATH=/path/to/app.db
UPLOADS_DIR=/path/to/uploads
# PORT=3001
# How many applications one page of the list shows; unset means 7.
# PAGE_SIZE=7

# Used by `npm run seed` to create your login. Pick your own values — these
# are not read anywhere else, and there is no signup form to change them
# later.
SEED_USERNAME=you
SEED_PASSWORD=change-me

# The MCP server (`npm run mcp`) reads these three, and all three are
# required. Claude Desktop supplies them in the `env` block of
# claude_desktop_config.json — they are NOT read from this file, which the
# MCP server never loads. See the README's "Claude Desktop (MCP)" section.
# JOBAPP_API_URL=http://localhost:3001
# JOBAPP_USERNAME=you
# JOBAPP_PASSWORD=change-me
